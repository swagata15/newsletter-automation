# Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Your Substack publication, e.g. https://yourname.substack.com
SUBSTACK_PUBLICATION_URL=

# Auth option 1 (recommended): browser cookie string.
# In your browser, open substack.com while logged in -> DevTools -> Application -> Cookies,
# copy the value of `substack.sid` and paste it as: substack.sid=VALUE
SUBSTACK_COOKIES=

# Auth option 2: email + password (often blocked by captcha on CI servers)
SUBSTACK_EMAIL=
SUBSTACK_PASSWORD=

# draft   -> create a draft for you to review in Substack (default, safest)
# publish -> publish and email subscribers immediately
PUBLISH_MODE=draft
